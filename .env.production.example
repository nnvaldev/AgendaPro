# Copia este archivo a .env.production en el servidor (nunca lo subas a git).
# Genera APP_KEY con:  docker run --rm ghcr.io/nnvaldev/agendapro php artisan key:generate --show

APP_NAME=AgendaPro
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://agendapro.example.com
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

# Dominio que sirve Caddy con HTTPS automático (sin https://).
SERVER_NAME=agendapro.example.com

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=agendapro
DB_USERNAME=agendapro
DB_PASSWORD=cambia-esta-clave

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379

# SMTP real (p. ej. Resend, Brevo o Mailgun en su plan gratuito).
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="reservas@agendapro.example.com"
MAIL_FROM_NAME="${APP_NAME}"
